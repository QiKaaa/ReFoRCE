# ========================================
# 环境变量配置示例
# ========================================
# 使用方法：
#   1. 复制此文件为 .env
#      cp .env.example .env
#   2. 填入真实的配置值
#   3. 运行程序会自动从 .env 中读取配置
# ========================================

# ----- API Key 配置 -----
# OpenAI API（推荐）
OPENAI_API_KEY=sk-your-api-key-here

# Azure OpenAI（可选，二选一）
# AZURE_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_KEY=your-azure-key-here

# DeepSeek API（可选）
# DS_API_KEY=your-deepseek-key-here

# ----- StarRocks 数据库配置 -----
# 注意：这些配置会被 run_starrocks.py 自动读取
DB_HOST=localhost
DB_PORT=9030
DB_USER=root
DB_PASSWORD=
DB_NAME=final_algorithm_competition
